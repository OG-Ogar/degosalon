# Supabase Postgres connection string for the Go backend.
# Copy the Session pooler URI from the Supabase project's Connect dialog.
# Never commit the real value.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

BOOKING_TIMEZONE=Africa/Lagos

# Google sign-in. Set both values from the Google Cloud console OAuth client.
# The redirect URI is /auth/google/callback on SITE_URL (or Render's URL).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to SITE_URL or RENDER_EXTERNAL_URL plus /auth/google/callback.
GOOGLE_REDIRECT_URL=

# Web Push, used for booking and chat alerts while the app is closed.
# Generate a pair with: go run ./cmd/vapid
# Leaving both unset keeps in-app alerts working; production will not be able
# to wake a closed browser without them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push service. Use a mailto: or https:// address.
VAPID_SUBJECT=mailto:support@example.com
